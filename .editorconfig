# EditorConfig for .NET projects
root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_size = 4
indent_style = space

# XAML code-behind files - suppress IntelliSense false positives
[**/*.xaml.cs]
# CS0103: The name 'InitializeComponent'/'RootFrame' does not exist (XAML-generated)
# CS1061: 'App' does not contain a definition for 'InitializeComponent' (XAML-generated)
# These are false positives - the code is generated by XAML compiler
dotnet_diagnostic_CS0103_severity = silent
dotnet_diagnostic_CS1061_severity = silent
