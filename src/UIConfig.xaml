<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Theme Dictionaries for Light and Dark themes -->
    <ResourceDictionary.ThemeDictionaries>
        
        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <!-- 5 Light Gray/White Colors -->
            <Color x:Key="BackgroundColor">#FFFFFF</Color>
            <Color x:Key="SurfaceColor">#FAFAFA</Color>
            <Color x:Key="Surface2Color">#F5F5F5</Color>
            <Color x:Key="Surface3Color">#EEEEEE</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            
            <!-- 5 Dark Gray/Black Colors for text -->
            <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="TextSecondaryColor">#424242</Color>
            <Color x:Key="TextTertiaryColor">#616161</Color>
            <Color x:Key="TextDisabledColor">#9E9E9E</Color>
            <Color x:Key="AccentColor">#0078D4</Color>
            
            <!-- Brushes using the colors above -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            
            <!-- UI Element specific brushes -->
            <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="SubtitleBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
        </ResourceDictionary>
        
        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <!-- 5 Dark Gray/Black Colors -->
            <Color x:Key="BackgroundColor">#1A1A1A</Color>
            <Color x:Key="SurfaceColor">#202020</Color>
            <Color x:Key="Surface2Color">#252525</Color>
            <Color x:Key="Surface3Color">#2A2A2A</Color>
            <Color x:Key="BorderColor">#333333</Color>
            
            <!-- 5 Light Gray/White Colors for text -->
            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#E0E0E0</Color>
            <Color x:Key="TextTertiaryColor">#B0B0B0</Color>
            <Color x:Key="TextDisabledColor">#757575</Color>
            <Color x:Key="AccentColor">#4CC2FF</Color>
            
            <!-- Brushes using the colors above -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            
            <!-- UI Element specific brushes -->
            <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="SubtitleBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
        </ResourceDictionary>
        
    </ResourceDictionary.ThemeDictionaries>
    
    <!-- Shared UI Sizing Resources (theme-independent) -->
    
    <!-- Padding -->
    <Thickness x:Key="Button.Padding">16,8,16,8</Thickness>
    <Thickness x:Key="Grid.Padding">20</Thickness>
    <Thickness x:Key="Border.Padding">12</Thickness>
    <Thickness x:Key="ScrollViewer.Padding">0</Thickness>
    
    <!-- Margins -->
    <Thickness x:Key="Button.Margin">8,0,0,0</Thickness>
    <Thickness x:Key="TextBlock.Margin">0,10,0,10</Thickness>
    <Thickness x:Key="Grid.Margin">0</Thickness>
    <Thickness x:Key="ComboBox.Margin">0,0,0,16</Thickness>
    <Thickness x:Key="Border.Margin">0,16,0,0</Thickness>
    <Thickness x:Key="SelectedFolderText.Margin">12,0,12,0</Thickness>
    <Thickness x:Key="InfoTextBlock.Margin">0</Thickness>
    <Thickness x:Key="ScrollViewer.Margin">0</Thickness>
    <Thickness x:Key="StackPanel.Margin">0,0,0,16</Thickness>
    
    <!-- Font Sizes -->
    <x:Double x:Key="FontSize.Title">24</x:Double>
    <x:Double x:Key="FontSize.Subtitle">14</x:Double>
    <x:Double x:Key="FontSize.Normal">13</x:Double>
    <x:Double x:Key="FontSize.Small">12</x:Double>
    
    <!-- Corner Radius -->
    <CornerRadius x:Key="Border.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Default">6</CornerRadius>
    
    <!-- Border Thickness -->
    <Thickness x:Key="BorderThickness.Default">1</Thickness>
    
    <!-- Widths -->
    <x:Double x:Key="ComboBox.Width">200</x:Double>
    
    <!-- Spacing -->
    <x:Double x:Key="StackPanel.Spacing">10</x:Double>
</ResourceDictionary>
