<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Numeric resources only -->
    <x:Double x:Key="Spacing.XXSmall">4</x:Double>
    <x:Double x:Key="Spacing.XSmall">8</x:Double>
    <x:Double x:Key="Spacing.Small">12</x:Double>
    <x:Double x:Key="Spacing.Medium">16</x:Double>
    <x:Double x:Key="Spacing.Large">20</x:Double>
    <x:Double x:Key="Spacing.XLarge">24</x:Double>
    <x:Double x:Key="Spacing.XXLarge">32</x:Double>
    <x:Double x:Key="Spacing.Huge">40</x:Double>

    <x:Double x:Key="Breakpoint.Compact">0</x:Double>
    <x:Double x:Key="Breakpoint.Medium">720</x:Double>
    <x:Double x:Key="Breakpoint.Wide">1080</x:Double>

    <x:Double x:Key="FontSize.Title">24</x:Double>
    <x:Double x:Key="FontSize.Subtitle">14</x:Double>
    <x:Double x:Key="FontSize.Normal">13</x:Double>
    <x:Double x:Key="FontSize.Small">12</x:Double>

    <x:Double x:Key="ComboBox.Width">200</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BackgroundColor">#FFFFFF</Color>
            <Color x:Key="SurfaceColor">#FAFAFA</Color>
            <Color x:Key="Surface2Color">#F5F5F5</Color>
            <Color x:Key="Surface3Color">#EEEEEE</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>

            <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="TextSecondaryColor">#424242</Color>
            <Color x:Key="TextTertiaryColor">#616161</Color>
            <Color x:Key="TextDisabledColor">#9E9E9E</Color>
            <Color x:Key="AccentColor">#0078D4</Color>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="SubtitleBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="LogTimestampBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="LogInfoBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="LogWarningBrush" Color="#B8860B" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#B4373B" />
            <SolidColorBrush x:Key="LogSuccessBrush" Color="#0B6623" />
            <SolidColorBrush x:Key="LogDebugBrush" Color="#4A4A4A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BackgroundColor">#1A1A1A</Color>
            <Color x:Key="SurfaceColor">#202020</Color>
            <Color x:Key="Surface2Color">#252525</Color>
            <Color x:Key="Surface3Color">#2A2A2A</Color>
            <Color x:Key="BorderColor">#333333</Color>

            <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#E0E0E0</Color>
            <Color x:Key="TextTertiaryColor">#B0B0B0</Color>
            <Color x:Key="TextDisabledColor">#757575</Color>
            <Color x:Key="AccentColor">#4CC2FF</Color>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="SubtitleBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="LogTimestampBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="LogInfoBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="LogWarningBrush" Color="#FFC93C" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="LogSuccessBrush" Color="#51CF66" />
            <SolidColorBrush x:Key="LogDebugBrush" Color="#C5C5C5" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
