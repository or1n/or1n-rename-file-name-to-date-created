<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Numeric resources only -->
    <x:Double x:Key="Spacing.XXSmall">4</x:Double>
    <x:Double x:Key="Spacing.XSmall">8</x:Double>
    <x:Double x:Key="Spacing.Small">12</x:Double>
    <x:Double x:Key="Spacing.Medium">16</x:Double>
    <x:Double x:Key="Spacing.Large">20</x:Double>
    <x:Double x:Key="Spacing.XLarge">24</x:Double>
    <x:Double x:Key="Spacing.XXLarge">32</x:Double>
    <x:Double x:Key="Spacing.Huge">40</x:Double>

    <Thickness x:Key="Padding.XSmall">8</Thickness>
    <Thickness x:Key="Padding.Small">12</Thickness>
    <Thickness x:Key="Padding.Medium">16</Thickness>
    <Thickness x:Key="Padding.Large">20</Thickness>

    <x:Double x:Key="Breakpoint.Compact">0</x:Double>
    <x:Double x:Key="Breakpoint.Medium">720</x:Double>
    <x:Double x:Key="Breakpoint.Wide">1080</x:Double>

    <x:Double x:Key="FontSize.Title">24</x:Double>
    <x:Double x:Key="FontSize.Subtitle">14</x:Double>
    <x:Double x:Key="FontSize.Normal">13</x:Double>
    <x:Double x:Key="FontSize.Small">12</x:Double>

    <x:Double x:Key="ComboBox.Width">200</x:Double>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- Theme-aware brushes that automatically switch with Light/Dark theme -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="Surface2Brush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Surface3Brush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
            
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#737373" />
            <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
            
            <SolidColorBrush x:Key="TitleBrush" Color="#000000" />
            <SolidColorBrush x:Key="SubtitleBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="LogTimestampBrush" Color="#737373" />
            <SolidColorBrush x:Key="LogInfoBrush" Color="#000000" />
            <SolidColorBrush x:Key="LogWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="LogSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="LogDebugBrush" Color="#5C5C5C" />
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="Surface2Brush" Color="#333333" />
            <SolidColorBrush x:Key="Surface3Brush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="BorderBrush" Color="#3C3C3C" />
            
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3B3B3" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
            
            <SolidColorBrush x:Key="TitleBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SubtitleBrush" Color="#B3B3B3" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="LogForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LogTimestampBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="LogInfoBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LogWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="LogErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="LogSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="LogDebugBrush" Color="#B3B3B3" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
