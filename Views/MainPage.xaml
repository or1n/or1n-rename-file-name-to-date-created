<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="or1n_rename_file_name_to_date_created.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:or1n_rename_file_name_to_date_created"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">
    <Page.Content>
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Margin="0,32,0,8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Style="{StaticResource MyLabel}" Text="or1n Rename File Name To Date Created" />

            <!-- Short Description -->
            <TextBlock Grid.Row="1" Margin="0,0,0,24" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" Text="A modern WinUI 3 app to batch rename files in a selected folder to their original date created/taken, with customizable formatting and smart options." />

            <!-- Folder Picker and Scan Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button x:Name="OpenFolderButton" Content="Open Folder" Click="OpenFolderButton_Click" />
                <TextBlock x:Name="SelectedFolderText" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0" Text="No folder selected" />
                <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
            </StackPanel>

            <!-- Results Area -->
            <Border Grid.Row="3" Margin="32,24,32,8" Padding="16" Background="#FFF8F8F8" CornerRadius="12" BorderBrush="#22000000" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Scan Results" Margin="0,0,0,8" />
                    <ListView x:Name="ResultsListView" Height="180" />
                </StackPanel>
            </Border>

            <!-- Progress/Info Box -->
            <Border Grid.Row="4" Margin="16,8,16,16" Background="#FFF0F0F0" CornerRadius="6">
                <TextBlock x:Name="InfoTextBlock" Margin="8,4,8,4" FontSize="13" Foreground="#FF333333" Text="Ready." TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Page.Content>
</Page>
