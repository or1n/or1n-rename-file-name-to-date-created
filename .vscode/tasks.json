{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deep Clean WinUI",
            "type": "shell",
            "command": ".\\clean_winui.ps1",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "echo": true
            }
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/or1n-rename-file-name-to-date-created.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "echo": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/or1n-rename-file-name-to-date-created.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "echo": true
            }
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/or1n-rename-file-name-to-date-created.csproj"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "echo": true
            }
        }
    ]
}