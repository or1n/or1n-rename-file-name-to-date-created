{
    "chat.tools.terminal.autoApprove": {
        "dotnet new": true,
        "dotnet run": true,
        "git init": true,
        "git add": true,
        "git commit": true,
        "gh": true,
        "dotnet clean": true,
        "dotnet build": true,
        "Get-Content": true,
        "Get-ChildItem": true,
        "Format-Table": true,
        "Start-Process": true,
        "Get-Process": true,
        "Where-Object": true,
        "dotnet add": true,
        "dotnet search": true,
        "Sort-Object": true,
        "Select-Object": true,
        "wevtutil": true,
        "findstr": true,
        "more": true,
        "Stop-Process": true,
        "Get-AppxPackage": true,
        "Get-ItemProperty": true,
        "Get-WindowsUpdateLog": true,
        "Get-HotFix": true,
        "dotnet msix": true,
        "Format-Hex": true,
        "/^dotnet --list-sdks; dotnet --list-runtimes$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "Get-WinEvent": true,
        "Format-List": true,
        "&": true,
        "Remove-Item": true,
        "taskkill": true,
        "git push": true,
        "msbuild": true,
        "dotnet restore": true,
        "git status": true,
        "del": true,
        "rmdir": true,
        ".\\obj": true
    },
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp"
    },
    "omnisharp.enableRoslynAnalyzers": false,
    "omnisharp.suppressRoslynAnalyzerNotifications": true,
    "csharp.showBackground": "off",
    "csharp.inlayHints.enableInlayHints": false,
    "csharp.diagnosticsOptions": {
        "disabled": ["CS0103", "CS1061"]
    },
    "problems.maxProblemsPerSource": 1000,
    "problems.exclude": {
        "**/*.xaml.cs": {
            "CS0103": true,
            "CS1061": true
        }
    }
}